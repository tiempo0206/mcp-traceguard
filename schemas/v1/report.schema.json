{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReportSummary": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "warnings": {
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "total"
      ],
      "title": "ReportSummary",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/tiempo0206/mcp-traceguard/main/schemas/v1/report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_captured_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Captured At"
    },
    "current_captured_at": {
      "title": "Current Captured At",
      "type": "string"
    },
    "fail_on": {
      "enum": [
        "warning",
        "error",
        "never"
      ],
      "title": "Fail On",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ReportSummary"
    }
  },
  "required": [
    "generated_at",
    "current_captured_at",
    "passed",
    "fail_on",
    "summary",
    "findings"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
